# Copy this file to `.env` and fill in the two values from your Supabase project.
#
#   PowerShell:  Copy-Item .env.example .env
#
# Find both values in the Supabase dashboard under
# Project Settings -> API (Project URL + anon/public key).
#
# Only the ANON key belongs here. Never paste the service_role key into this
# file: it bypasses every row-level security rule and must stay server-side.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. The public address of the hosted web build, used to build the
# "share your pace" link shown in Settings. Leave it out on the web: the
# current origin is used there. On a phone, without it, Settings shows the
# raw token instead of a full URL.
# EXPO_PUBLIC_SHARE_BASE_URL=https://pace.example.com
